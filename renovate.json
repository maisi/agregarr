{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:js-app",
    "group:allNonMajor",
    "docker:disableMajor",
    "helpers:disableTypesNodeMajor"
  ],
  "packageRules": [
    {
      "description": "Group routine minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor and patch dependencies",
      "groupSlug": "minor-patch"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "matchPackageNames": [
        "node"
      ],
      "groupName": "Node.js",
      "groupSlug": "node"
    },
    {
      "description": "Isolate every major update from all inherited and local groups",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Require human merging for every dependency",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    },
    {
      "description": "Keep already marked security updates immediate without reviving suppressed updates",
      "matchJsonata": [
        "isVulnerabilityAlert = true and $not(enabled = false) and $not($exists(skipReason))"
      ],
      "enabled": true,
      "schedule": [
        "at any time"
      ],
      "prCreation": "immediate",
      "groupName": null,
      "groupSlug": null,
      "dependencyDashboardApproval": false,
      "minimumReleaseAge": null,
      "automerge": false,
      "prConcurrentLimit": 0,
      "branchConcurrentLimit": 0
    }
  ],
  "timezone": "Europe/Vienna",
  "schedule": [
    "before 7am on monday"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am on monday"
    ],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "automerge": false,
    "groupName": null,
    "groupSlug": null,
    "prCreation": "immediate",
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "prConcurrentLimit": 0,
    "branchConcurrentLimit": 0
  }
}
